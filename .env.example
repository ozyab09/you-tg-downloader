# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Белый список Telegram user_id через запятую (пусто = отвечать всем, не рекомендуется)
TELEGRAM_USER_ALLOW_IDS=11111111,22222222
# Алиас (обратная совместимость): ALLOWED_USER_IDS=11111111,22222222

# Лимит размера файла, МБ (50 — лимит Telegram Bot API для обычных ботов)
MAX_FILE_SIZE_MB=50

# Максимальная длительность видео, минут
MAX_VIDEO_DURATION_MIN=30

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Дополнительно (опционально):
# Параллельных скачиваний всего
MAX_CONCURRENT_DOWNLOADS=2
# TTL кэша метаданных, секунд
METADATA_CACHE_TTL_SEC=300
# Максимум редактирований сообщения прогресса на одну загрузку
MAX_PROGRESS_EDITS=20
